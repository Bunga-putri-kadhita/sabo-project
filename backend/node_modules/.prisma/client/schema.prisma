generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  KASIR
}

enum BookingStatus {
  PENDING
  APPROVED
  DIPROSES
  SELESAI
}

enum MechanicStatus {
  AKTIF
  TIDAK_AKTIF
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles         Vehicle[]
  bookings         Booking[]
  sentMessages     ChatMessage[] @relation("SenderMessages")
  receivedMessages ChatMessage[] @relation("ReceiverMessages")
}

model Vehicle {
  id        Int      @id @default(autoincrement())
  userId    Int
  platNomor String   @unique
  merk      String
  tipe      String
  transmisi String
  tahun     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Service {
  id            Int      @id @default(autoincrement())
  namaLayanan   String
  harga         Decimal  @db.Decimal(12, 2)
  estimasiMenit Int
  deskripsi     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookingDetails BookingDetail[]
}

model Mechanic {
  id          Int            @id @default(autoincrement())
  namaMekanik String
  noHp        String?
  statusAktif MechanicStatus @default(AKTIF)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  bookings Booking[]
}

model Booking {
  id          Int           @id @default(autoincrement())
  bookingCode String        @unique
  userId      Int
  vehicleId   Int
  mechanicId  Int?
  bookingDate DateTime
  bookingTime String
  totalPrice  Decimal       @db.Decimal(12, 2)
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  mechanic       Mechanic?       @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
  bookingDetails BookingDetail[]
  review         Review?
  chatMessages   ChatMessage[]
}

model BookingDetail {
  id        Int     @id @default(autoincrement())
  bookingId Int
  serviceId Int
  price     Decimal @db.Decimal(12, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  senderId   Int
  receiverId Int
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender   User    @relation("SenderMessages", fields: [senderId], references: [id])
  receiver User    @relation("ReceiverMessages", fields: [receiverId], references: [id])
}
